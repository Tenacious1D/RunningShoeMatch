# Copy this file to .env.local and replace only the placeholder values.
# Find these public values in your Supabase project's Connect dialog or
# Settings > API Keys. The publishable key is intended for browser use and
# access is still controlled by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional, server-only credentials for future trusted import/admin processes.
# Do not add NEXT_PUBLIC_ to either variable. A secret key bypasses Row Level
# Security and must never be used in a Client Component or committed to Git.
# These values are not required for the public app or /dev/database check.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME